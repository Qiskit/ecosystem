{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Check ups",
  "type": "object",
  "patternProperties": {
    "^[A-Z0-9]{3}$": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "applies_to": {
          "type": "string"
        },
        "importance": {
          "type": "string"
        },
        "cure_period_in_days": {
          "type": "integer",
          "minimum": -1,
          "description": "Overrides the cure period of the importance level of this check up. A negative value (by convention, -1) is an infinite cure period: the check up stays pending, but it never retires the project."
        }
      },
      "required": [
        "title",
        "description"
      ]
    },
    "^importance$": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "cure_period_in_days": {
            "type": "integer",
            "minimum": -1,
            "description": "Days a member can keep failing a check up of this importance before being retired. 0 means the check up has to pass at all times. A negative value (by convention, -1) is an infinite cure period: the check up stays pending, but it never retires the project."
          },
          "icon": {
            "type": "string"
          }
        },
        "required": ["name", "description"]
      }
    },
    "^categories$": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["name", "description"]
      }
    }
  }
}

