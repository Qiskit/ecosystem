{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Member toml file",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ibm_maintained": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "documentation": {
      "type": "string"
    },
    "packages": {
      "type": "array",
      "items": {}
    },
    "uuid": {
      "type": "string"
    },
    "maturity": {
      "type": "string",
      "enum": [
        "production-ready",
        "experimental",
        "bugfixing only",
        "as-is",
        "deprecated"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Qiskit Project",
        "Member",
        "Early Project",
        "Very Early Project",
        "Unmaintained",
        "Under revision",
        "Alumni"
      ]
    },
    "github": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "stars": {
          "type": "integer"
        },
        "homepage": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "total_dependent_repositories": {
          "type": "integer"
        },
        "total_dependent_packages": {
          "type": "integer"
        },
        "created_at": {
          "type": "string",
          "format": "date"
        },
        "last_commit": {
          "type": "string",
          "format": "date"
        },
        "last_activity": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "owner",
        "repo"
      ]
    },
    "badge": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "style": {
          "type": "string"
        }
      },
      "required": [
        "style"
      ]
    },
    "checks": {
      "type": "object",
      "patternProperties": {
        "^[A-Z0-9]{3}$": {
          "type": "object",
          "properties": {
            "xfailed": {
              "type": "string"
            },
            "xfailed_until": {
              "type": "string",
              "format": "date"
            },
            "since": {
              "type": "string",
              "format": "date"
            },
            "source": {
              "type": "string"
            },
            "details": {
              "type": "string"
            },
            "discussion": {
              "type": "string"
            },
            "importance": {
              "type": "string"
            }
          },
          "anyOf": [
            {
              "$comment": "xfailed_until is the expiration of the xfailed explanation, so it is meaningless on its own",
              "required": [
                "xfailed"
              ]
            },
            {
              "not": {
                "required": [
                  "xfailed_until"
                ]
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pypi": {
      "$comment": "What PyPI says about each distribution this project publishes. An array: an entry is identified by its own `package_name`, which it stores anyway",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "package_name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "last_release_date": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "requires_qiskit": {
            "type": "string"
          },
          "compatible_with_qiskit_v1": {
            "type": "boolean"
          },
          "compatible_with_qiskit_v2": {
            "type": "boolean"
          },
          "highest_supported_qiskit_release_date": {
            "type": "string"
          },
          "highest_supported_qiskit_version": {
            "type": "string"
          },
          "last_month_downloads": {
            "type": "integer"
          },
          "last_180_days_downloads": {
            "type": "integer"
          }
        },
        "required": [
          "package_name"
        ]
      }
    },
    "crates": {
      "$comment": "What crates.io says about each crate this project publishes. No qiskit requirement: Qiskit publishes no crate, so there is nothing on that registry to depend on",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "package_name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "last_release_date": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "maintainers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rust_version": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "total_downloads": {
            "type": "integer"
          },
          "last_90_days_downloads": {
            "type": "integer"
          }
        },
        "required": [
          "package_name"
        ],
        "additionalProperties": false
      }
    },
    "julia": {
      "$comment": "What the Julia registry says about each package this project publishes",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "package_name": {
            "type": "string"
          },
          "registry": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "homepage": {
            "type": "string"
          },
          "release_date": {
            "type": "string"
          },
          "requires_julia": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_qiskit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "juliahub_url": {
            "type": "string"
          },
          "general_registry_url": {
            "type": "string"
          },
          "uuid": {
            "type": "string"
          },
          "estimated_unique_users": {
            "type": "integer"
          },
          "monthly_downloads": {
            "type": "integer"
          },
          "total_downloads": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": [
          "package_name"
        ]
      }
    },
    "cargo": {
      "$comment": "Each crate the repository declares in a `Cargo.toml` without publishing it. Discovered from the manifests, so it has a `path` and no URL",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "package_name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "rust_version": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "crate_type": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "package_name"
        ],
        "additionalProperties": false
      }
    },
    "python": {
      "$comment": "Each distribution the repository declares in its packaging manifests. `path` says which directory it is in, `source` which manifests were read",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "package_name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "requires_python": {
            "type": "string"
          },
          "requires_qiskit": {
            "type": "string"
          },
          "compatible_with_qiskit_v1": {
            "type": "boolean"
          },
          "compatible_with_qiskit_v2": {
            "type": "boolean"
          },
          "highest_supported_qiskit_release_date": {
            "type": "string",
            "format": "date"
          },
          "highest_supported_qiskit_version": {
            "type": "string"
          },
          "build_backend": {
            "type": "string"
          },
          "path": {
            "$comment": "Directory holding the manifests, for a monorepo. Cannot be discovered, so it is declared",
            "type": "string"
          },
          "source": {
            "$comment": "Which files the values came from. requirements.txt is not a manifest: it appears only when it is where the dependencies were read",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pyproject.toml",
                "setup.cfg",
                "setup.py",
                "requirements.txt"
              ]
            }
          },
          "deferred": {
            "$comment": "Fields the build backend computes, so not readable from the manifests",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "package_name",
          "source",
          "deferred"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "$comment": "What the repository's requirements files say about Qiskit: the files discovered in the root when it declares no packaging manifest, plus any file declared as a URL in `packages`, which is how one outside the root is recorded. Not distributions, so there is no name to key them by: an array with one entry per file that names qiskit, every one of them read by the check ups",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "$comment": "The requirements file these values were read from, as a repository-relative path",
            "type": "string",
            "pattern": "^([^/]+/)*[^/]*[Rr]equirements[^/]*\\.txt$"
          },
          "requires_qiskit": {
            "type": "string"
          },
          "compatible_with_qiskit_v1": {
            "type": "boolean"
          },
          "compatible_with_qiskit_v2": {
            "type": "boolean"
          },
          "highest_supported_qiskit_release_date": {
            "type": "string",
            "format": "date"
          },
          "highest_supported_qiskit_version": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "requires_qiskit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "url",
    "uuid",
    "maturity"
  ]
}
